# Copy to .env for local development: `cp .env.example .env`
# The database comes from `docker compose up -d` (local-only credentials, bound to 127.0.0.1).
DATABASE_URL=postgres://pump:pump_local_only@localhost:55432/pump
# Integration tests use their own database (created by docker/create-test-database.sql).
TEST_DATABASE_URL=postgres://pump:pump_local_only@localhost:55432/pump_test
PORT=3000
LOG_LEVEL=info

# Production settings come from render.yaml (Render), not from a file:
# NODE_ENV=production
# PORT=10000
# DATABASE_URL=<the database's internal URL, wired up by the Blueprint>
# TRUST_PROXY=uniquelocal   # addresses of trusted proxies; never "true"
# WEB_DIST_DIR=/app/apps/web/dist   # set by the Dockerfile
